POLICY_PACK_PATH=config/policy.yaml
RUNS_DIR=runs
CLAIMS_DIR=claims
LOG_LEVEL=INFO

# Optional — OpenAI advisory agent (liability + compliance). Without a key the
# advisory degrades gracefully and the deterministic pipeline is unaffected.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — tracker posting (REQ-051). Leave TRACKER_TYPE unset for a local
# dry-run. Set to "jira" or "ado" with the matching credentials to post for real.
TRACKER_TYPE=
# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Azure DevOps
ADO_ORG_URL=
ADO_PROJECT=
ADO_PAT=
